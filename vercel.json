{
  "version": 2,
  "routes": [
    {
      "src": "/a/(?<slug>[^/]+)",
      "dest": "/api/a?slug=$slug"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/isoteri-lab/(.*)",
      "dest": "/tofarmer-web/isoteri-lab/$1"
    },
    {
      "src": "/isoteri-lab",
      "dest": "/tofarmer-web/isoteri-lab/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/tofarmer-web/$1"
    }
  ]
}