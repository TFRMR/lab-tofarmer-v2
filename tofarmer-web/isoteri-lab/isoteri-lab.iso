catatan: Isoteri Lab - HTML/CSS native, logic aplikasi Isoteri.
bentuk Tugas { teks, selesai }
bentuk AppState { halaman, tugas, teks_input, jumlah_render }

fungsi data_awal() {
    kembalikan [
        Tugas { teks: "Rapikan parser dan diagnostic compiler", selesai: salah },
        Tugas { teks: "Lanjutkan overflow-trapping di JIT", selesai: salah },
        Tugas { teks: "Uji semantic parity semua backend", selesai: benar },
        Tugas { teks: "Buat demo web tanpa JavaScript aplikasi", selesai: benar },
        Tugas { teks: "Siapkan package manager dan lockfile", selesai: salah }
    ]
}

fungsi hitung_selesai(daftar) {
    ingat n = 0
    ingat i = 0
    ulang (i < panjang(daftar)) {
        kalau (daftar[i].selesai) { n = n + 1 }
        i = i + 1
    }
    kembalikan n
}

fungsi render(props, state) {
    kalau (state.halaman == "tugas") { kembalikan render_tugas(state) }
    kalau (state.halaman == "arsitektur") { kembalikan render_arsitektur() }
    kalau (state.halaman == "tentang") { kembalikan render_tentang() }
    kembalikan render_beranda(state)
}

fungsi daftar_html(daftar) {
    ingat html = ""
    ingat i = 0
    ulang (i < panjang(daftar)) {
        ingat t = daftar[i]
        ingat c = "check"
        ingat s = "task-text"
        kalau (t.selesai) { c = "check done"; s = "task-text done" }
        html = html + "<div class='task'><button class='" + c + "' data-aksi='toggle' data-indeks='" + i + "'>✓</button><span class='" + s + "'>" + t.teks + "</span><button class='delete' data-aksi='hapus' data-indeks='" + i + "'>×</button></div>"
        i = i + 1
    }
    kembalikan html
}

fungsi render_beranda(state) {
    ingat selesai = hitung_selesai(state.tugas)
    kembalikan "<section class='page'><div class='top'><div><p class='eyebrow'>Isoteri Native Web</p><h1>Web modern, logic Isoteri.</h1><p class='sub'>HTML dan CSS tetap native. State, component, event, CRUD dan navigasi aplikasi dipindahkan ke Isoteri.</p></div><span class='pill'>tanpa JS aplikasi</span></div><div class='hero'><h2>Isoteri Lab</h2><p>JavaScript di halaman ini hanya bootstrap VM. Business logic aplikasi berada di <b>isoteri-lab.iso</b> dan dieksekusi sebagai bytecode web.</p><code>HTML + CSS + Isoteri VM + isoteri-lab.iso</code></div><div class='grid'><div class='card'><div class='label'>Total tugas</div><div class='value'>" + panjang(state.tugas) + "</div><div class='good'>state Isoteri</div></div><div class='card'><div class='label'>Selesai</div><div class='value'>" + selesai + "</div><div class='good'>reducer action</div></div><div class='card'><div class='label'>Render</div><div class='value'>" + state.jumlah_render + "</div><div class='good'>component update</div></div><div class='card'><div class='label'>Layer</div><div class='value'>4</div><div class='good'>HTML · CSS · ISO · VM</div></div></div><div class='cols'><div class='card'><div class='head'><h2>Tugas terbaru</h2><span class='label'>interaktif</span></div>" + daftar_html(state.tugas) + "</div><div class='card'><div class='head'><h2>Pembagian kerja</h2></div><div class='stack'><div class='stack-item'><span class='icon'>1</span><div><b>HTML</b><p>Struktur dan semantik dokumen tetap native.</p></div></div><div class='stack-item'><span class='icon'>2</span><div><b>CSS</b><p>Layout, responsive design dan visual tetap native.</p></div></div><div class='stack-item'><span class='icon'>3</span><div><b>Isoteri</b><p>State, event, component dan aturan aplikasi.</p></div></div><div class='stack-item'><span class='icon'>4</span><div><b>VM</b><p>Menjalankan bytecode Isoteri di browser.</p></div></div></div></div></div></section>"
}

fungsi render_tugas(state) {
    kembalikan "<section class='page'><div class='top'><div><p class='eyebrow'>State Management</p><h1>Tugas</h1><p class='sub'>Tambah, toggle dan hapus data. Semua aksi berasal dari reducer Isoteri.</p></div></div><div class='card'><div class='toolbar'><input class='input' data-aksi='ubah_input' data-peristiwa='input' value='" + state.teks_input + "' placeholder='Tugas baru…'><button class='primary' data-aksi='tambah'>Tambah</button></div>" + daftar_html(state.tugas) + "</div></section>"
}

fungsi render_arsitektur() {
    kembalikan "<section class='page'><div class='top'><div><p class='eyebrow'>Architecture</p><h1>Empat lapisan.</h1><p class='sub'>Platform browser tidak perlu diganti. Yang dipindahkan adalah logic aplikasi.</p></div></div><div class='arch'><article><b>01 · SOURCE</b><h3>Isoteri</h3><p>Source .iso berisi state, component, event dan business logic.</p></article><article><b>02 · EXPORT</b><h3>Bytecode</h3><p>Compiler menghasilkan isoteri-web-bytecode-v1 sebagai JSON.</p></article><article><b>03 · RUNTIME</b><h3>VM</h3><p>isoteri-vm.js menginterpretasikan bytecode di browser.</p></article><article><b>04 · PLATFORM</b><h3>Browser</h3><p>DOM, CSS, storage, fetch dan API web tetap native.</p></article></div><div class='code'>isoteri-lab.iso
  ↓ ekspor-web
isoteri-lab.isoweb.json
  ↓ IsoteriVM
HTML + CSS + Browser APIs</div></section>"
}

fungsi render_tentang() {
    kembalikan "<section class='page prose'><div class='top'><div><p class='eyebrow'>Tentang eksperimen</p><h1>Seberapa jauh Isoteri bisa menggantikan JavaScript?</h1></div></div><div class='card'><p>Tujuannya bukan menghapus HTML atau CSS. Keduanya memang bagian natural dari web. Targetnya adalah memindahkan logic aplikasi yang biasanya berada di JavaScript ke Isoteri.</p><p>Bootstrap JavaScript sengaja dibuat sangat tipis: fetch bundle, buat VM, lalu jalankan. Setelah itu state dan aksi UI hidup di Isoteri.</p><p>Demo ini juga menjadi benchmark ergonomi nyata untuk runtime web sebelum kita memperluas API dan compiler.</p></div></section>"
}

fungsi aksi_navigasi(props, state, e) {
    kembalikan AppState { halaman: dom_atribut(e.target, "data-halaman"), tugas: state.tugas, teks_input: state.teks_input, jumlah_render: state.jumlah_render + 1 }
}
fungsi aksi_ubah_input(props, state, e) {
    kembalikan AppState { halaman: state.halaman, tugas: state.tugas, teks_input: e.nilai, jumlah_render: state.jumlah_render + 1 }
}
fungsi aksi_tambah(props, state, e) {
    kalau (panjang(state.teks_input) == 0) { kembalikan state }
    ingat baru = gabung(state.tugas, [Tugas { teks: state.teks_input, selesai: salah }])
    kembalikan AppState { halaman: "tugas", tugas: baru, teks_input: "", jumlah_render: state.jumlah_render + 1 }
}
fungsi aksi_toggle(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        ingat t = state.tugas[i]
        kalau (i == idx) { baru = gabung(baru, [Tugas { teks: t.teks, selesai: !t.selesai }]) }
        lainnya { baru = gabung(baru, [t]) }
        i = i + 1
    }
    kembalikan AppState { halaman: state.halaman, tugas: baru, teks_input: state.teks_input, jumlah_render: state.jumlah_render + 1 }
}
fungsi aksi_hapus(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        kalau (i != idx) { baru = gabung(baru, [state.tugas[i]]) }
        i = i + 1
    }
    kembalikan AppState { halaman: state.halaman, tugas: baru, teks_input: state.teks_input, jumlah_render: state.jumlah_render + 1 }
}

ingat aplikasi = komponen_buat({
    "state_awal": AppState { halaman: "beranda", tugas: data_awal(), teks_input: "", jumlah_render: 0 },
    "render": "render",
    "aksi": { "navigasi": "aksi_navigasi", "ubah_input": "aksi_ubah_input", "tambah": "aksi_tambah", "toggle": "aksi_toggle", "hapus": "aksi_hapus" }
})
komponen_pasang(aplikasi, dom_pilih("#app"))
