catatan: Demo aplikasi web nyata.
catatan: HTML + CSS tetap menjadi lapisan presentasi.
catatan: Semua perilaku aplikasi di bawah ini ditulis dengan Isoteri.

bentuk Tugas {
    teks,
    selesai,
    prioritas
}

bentuk AppState {
    halaman,
    pencarian,
    tugas,
    jumlah_selesai,
    tema_terang,
    modal_buka,
    toast,
    detik
}

fungsi teks_bool(nilai) {
    kalau (nilai) { kembalikan "ya" }
    kembalikan "tidak"
}

fungsi hitung_selesai(daftar) {
    ingat n = 0
    ingat i = 0
    ulang (i < panjang(daftar)) {
        kalau (daftar[i].selesai) { n = n + 1 }
        i = i + 1
    }
    kembalikan n
}

fungsi cocok_tugas(tugas, q) {
    kalau (panjang(q) == 0) { kembalikan benar }
    kembalikan mengandung(tugas.teks, q)
}

fungsi ikon_halaman(nama, aktif) {
    ingat kelas = ""
    kalau (aktif) { kelas = "aktif" }
    kalau (nama == "beranda") { kembalikan "<a data-aksi='navigasi' class='" + kelas + "' href='#/'><span class='ikon'>⌂</span>Beranda</a>" }
    kalau (nama == "tugas") { kembalikan "<a data-aksi='navigasi' class='" + kelas + "' href='#/tugas'><span class='ikon'>✓</span>Tugas</a>" }
    kalau (nama == "proyek") { kembalikan "<a data-aksi='navigasi' class='" + kelas + "' href='#/proyek'><span class='ikon'>◇</span>Proyek</a>" }
    kembalikan "<a data-aksi='navigasi' class='" + kelas + "' href='#/pengaturan'><span class='ikon'>⚙</span>Pengaturan</a>"
}

fungsi render_sidebar(state) {
    kembalikan "<aside class='sidebar'>" +
        "<div class='brand'><div class='logo'>I</div><div><strong>Isoteri Studio</strong><small>Web Native-ish</small></div></div>" +
        "<nav class='nav'>" +
        ikon_halaman("beranda", state.halaman == "beranda") +
        ikon_halaman("tugas", state.halaman == "tugas") +
        ikon_halaman("proyek", state.halaman == "proyek") +
        ikon_halaman("pengaturan", state.halaman == "pengaturan") +
        "</nav>" +
        "<div class='sidebar-bottom'><div class='status'><span class='dot'></span>Runtime Isoteri aktif</div><div class='status'>JS aplikasi: 0 baris</div></div>" +
        "</aside>"
}

fungsi render_tugas_ringkas(state) {
    ingat html = ""
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        ingat t = state.tugas[i]
        ingat kelas = "check"
        kalau (t.selesai) { kelas = "check on" }
        html = html + "<div class='item'><div class='" + kelas + "'>" + (kalau_tidak(t.selesai, "✓", "")) + "</div><div class='item-main'><div class='item-title'>" + t.teks + "</div><div class='item-meta'>Isoteri task · prioritas " + t.prioritas + "</div></div><span class='badge " + badge_prioritas(t.prioritas) + "'>" + t.prioritas + "</span></div>"
        i = i + 1
    }
    kembalikan html
}

fungsi kalau_tidak(kondisi, benar_teks, salah_teks) {
    kalau (kondisi) { kembalikan benar_teks }
    kembalikan salah_teks
}

fungsi badge_prioritas(p) {
    kalau (p == "tinggi") { kembalikan "kuning" }
    kalau (p == "selesai") { kembalikan "hijau" }
    kembalikan ""
}

fungsi render_beranda(props, state) {
    kembalikan "<div class='app-shell'>" + render_sidebar(state) + "<main class='main'>" +
        "<div class='topbar'><div><div class='eyebrow'>Aplikasi nyata · tanpa JS aplikasi</div><h1>Selamat datang di Isoteri.</h1><p class='subtitle'>Halaman ini sengaja dibuat seperti dashboard modern. HTML dan CSS tetap dipakai sebagai lapisan web, sementara state, event, router, penyimpanan, timer, dan rendering interaktif dijalankan oleh program Isoteri.</p></div><div class='actions'><button class='btn' data-aksi='tema'>" + kalau_tidak(state.tema_terang, "☀ Tema terang", "☾ Tema gelap") + "</button><button class='btn primary' data-aksi='modal'>+ Proyek baru</button></div></div>" +
        "<div class='grid stats'>" +
          "<div class='card stat'><div class='label'>Tugas aktif</div><div class='num'>" + (panjang(state.tugas) - state.jumlah_selesai) + "</div><div class='delta'>terus diproses</div></div>" +
          "<div class='card stat'><div class='label'>Selesai</div><div class='num'>" + state.jumlah_selesai + "</div><div class='delta'>dari " + panjang(state.tugas) + " tugas</div></div>" +
          "<div class='card stat'><div class='label'>Runtime</div><div class='num'>VM</div><div class='delta'>bytecode Isoteri</div></div>" +
          "<div class='card stat'><div class='label'>JavaScript aplikasi</div><div class='num'>0</div><div class='delta'>hanya bootstrap VM</div></div>" +
        "</div>" +
        "<div class='grid content-grid'>" +
          "<div class='grid'>" +
            "<section class='card hero'><h2>Bahasa Indonesia → aplikasi web.</h2><p>Yang tidak bisa digantikan bahasa tetap ditangani HTML/CSS. Yang biasanya membutuhkan JavaScript—state, event handler, routing, localStorage, timer, filter, dan aksi UI—didelegasikan ke Isoteri.</p><div class='chips'><span class='chip'>DOM</span><span class='chip'>Event</span><span class='chip'>State</span><span class='chip'>Router</span><span class='chip'>Component</span><span class='chip'>Storage</span><span class='chip'>Timer</span><span class='chip'>Fetch-ready</span></div></section>" +
            "<section class='card'><div class='card-head'><h2>Tugas terbaru</h2><span>state hidup di Isoteri</span></div><div class='card-body'><div class='list'>" + render_tugas_ringkas(state) + "</div><div style='margin-top:13px'><a class='btn' href='#/tugas'>Kelola semua tugas →</a></div></div></section>" +
          "</div>" +
          "<aside class='grid'>" +
            "<section class='card'><div class='card-head'><h2>Arsitektur</h2><span>lapisan</span></div><div class='card-body'><div class='kpi'><span>Markup</span><strong>HTML</strong></div><div class='kpi'><span>Tampilan</span><strong>CSS</strong></div><div class='kpi'><span>Interaksi</span><strong>Isoteri</strong></div><div class='kpi'><span>Runtime</span><strong>Isoteri VM</strong></div><div class='kpi'><span>Native bootstrap</span><strong>JS minimal</strong></div></div></section>" +
            "<section class='card'><div class='card-head'><h2>Hitung mundur demo</h2><span>timer</span></div><div class='card-body'><div style='font-size:30px;font-weight:800'>" + state.detik + "s</div><div style='color:var(--muted);font-size:11px;margin-top:5px'>state diperbarui dari callback timer Isoteri</div></div></section>" +
          "</aside>" +
        "</div>" +
      "</main></div>"
}

fungsi render_tugas(props, state) {
    ingat html = ""
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        ingat t = state.tugas[i]
        kalau (cocok_tugas(t, state.pencarian)) {
            ingat kelas = "check"
            kalau (t.selesai) { kelas = "check on" }
            ingat status = kalau_tidak(t.selesai, "selesai", "aktif")
            html = html + "<div class='item'><button class='" + kelas + "' data-aksi='toggle' data-indeks='" + i + "'>" + kalau_tidak(t.selesai, "✓", "") + "</button><div class='item-main'><div class='item-title'>" + t.teks + "</div><div class='item-meta'>Status: " + status + " · prioritas: " + t.prioritas + "</div></div><span class='badge " + badge_prioritas(status) + "'>" + status + "</span><button class='btn' data-aksi='hapus' data-indeks='" + i + "'>Hapus</button></div>"
        }
        i = i + 1
    }
    kembalikan "<div class='app-shell'>" + render_sidebar(state) + "<main class='main'><div class='topbar'><div><div class='eyebrow'>State + Event + Component</div><h1>Daftar tugas</h1><p class='subtitle'>Input, pencarian, toggle, penghapusan, dan persistensi lokal semuanya berasal dari Isoteri.</p></div><div class='actions'><a class='btn' href='#/'>← Dashboard</a></div></div>" +
      "<section class='card'><div class='card-head'><h2>Tugas</h2><span>" + state.jumlah_selesai + "/" + panjang(state.tugas) + " selesai</span></div><div class='card-body'><div class='form-row'><input class='search' data-aksi='cari' data-peristiwa='input' value='" + state.pencarian + "' placeholder='Cari tugas…'><button class='btn primary' data-aksi='tambah'>+ Tambah</button></div><div class='list'>" + html + "</div></div></section></main></div>"
}

fungsi render_proyek(props, state) {
    kembalikan "<div class='app-shell'>" + render_sidebar(state) + "<main class='main'><div class='topbar'><div><div class='eyebrow'>Project showcase</div><h1>Proyek Isoteri</h1><p class='subtitle'>Contoh bagaimana runtime web dapat menjadi fondasi aplikasi yang lebih besar tanpa memaksa seluruh stack masuk ke JavaScript.</p></div><div class='actions'><button class='btn primary' data-aksi='modal'>+ Proyek baru</button></div></div>" +
      "<div class='grid content-grid'><section class='card'><div class='card-head'><h2>isoteri-web-app</h2><span>aktif</span></div><div class='card-body'><div class='code'><span class='kw'>fungsi</span> render_halaman(props, state) {<br>&nbsp;&nbsp;<span class='kw'>kembalikan</span> <span class='str'>&quot;&lt;section&gt;...&lt;/section&gt;&quot;</span><br>}<br><br><span class='kw'>dom_ketika</span>(tombol, <span class='str'>&quot;klik&quot;</span>, fungsi(e) {<br>&nbsp;&nbsp;state_ubah(...);<br>})</div></div></section><section class='card'><div class='card-head'><h2>Yang sudah dicoba</h2><span>runtime web</span></div><div class='card-body'><div class='list'><div class='item'><div class='check on'>✓</div><div class='item-main'><div class='item-title'>DOM + Event</div><div class='item-meta'>query, create, class, attribute, event data</div></div></div><div class='item'><div class='check on'>✓</div><div class='item-main'><div class='item-title'>Router + State</div><div class='item-meta'>hash routing dan pub/sub</div></div></div><div class='item'><div class='check on'>✓</div><div class='item-main'><div class='item-title'>Component</div><div class='item-meta'>render + reducer-style action</div></div></div><div class='item'><div class='check on'>✓</div><div class='item-main'><div class='item-title'>Storage + Timer</div><div class='item-meta'>localStorage dan callback timer</div></div></div></div></div></section></div></main></div>"
}

fungsi render_pengaturan(props, state) {
    kembalikan "<div class='app-shell'>" + render_sidebar(state) + "<main class='main'><div class='topbar'><div><div class='eyebrow'>Konfigurasi</div><h1>Pengaturan</h1><p class='subtitle'>Tema dan preferensi demo disimpan oleh runtime browser.</p></div></div><div class='grid content-grid'><section class='card'><div class='card-head'><h2>Tampilan</h2><span>local state</span></div><div class='card-body'><div class='item'><div class='item-main'><div class='item-title'>Tema terang</div><div class='item-meta'>Aktif: " + teks_bool(state.tema_terang) + "</div></div><button class='btn' data-aksi='tema'>Ganti tema</button></div></div></section><section class='card'><div class='card-head'><h2>Prinsip demo</h2><span>tanpa JS aplikasi</span></div><div class='card-body'><div class='kpi'><span>HTML</span><strong>tetap</strong></div><div class='kpi'><span>CSS</span><strong>tetap</strong></div><div class='kpi'><span>JavaScript</span><strong>VM bootstrap saja</strong></div><div class='kpi'><span>Logika UI</span><strong>Isoteri</strong></div></div></section></div></main></div>"
}

fungsi render(props, state) {
    kalau (state.halaman == "tugas") { kembalikan render_tugas(props, state) }
    kalau (state.halaman == "proyek") { kembalikan render_proyek(props, state) }
    kalau (state.halaman == "pengaturan") { kembalikan render_pengaturan(props, state) }
    kembalikan render_beranda(props, state)
}

fungsi aksi_navigasi(props, state, e) {
    ingat href = dom_atribut(e.target, "href")
    ingat halaman = "beranda"
    kalau (href == "#/tugas") { halaman = "tugas" }
    kalau (href == "#/proyek") { halaman = "proyek" }
    kalau (href == "#/pengaturan") { halaman = "pengaturan" }
    kembalikan AppState { halaman: halaman, pencarian: state.pencarian, tugas: state.tugas, jumlah_selesai: state.jumlah_selesai, tema_terang: state.tema_terang, modal_buka: state.modal_buka, toast: state.toast, detik: state.detik }
}

fungsi aksi_cari(props, state, e) {
    kembalikan AppState { halaman: state.halaman, pencarian: e.nilai, tugas: state.tugas, jumlah_selesai: state.jumlah_selesai, tema_terang: state.tema_terang, modal_buka: state.modal_buka, toast: state.toast, detik: state.detik }
}

fungsi aksi_toggle(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        ingat t = state.tugas[i]
        kalau (i == idx) { baru = gabung(baru, [Tugas { teks: t.teks, selesai: !t.selesai, prioritas: kalau_tidak(t.selesai, t.prioritas, "selesai") }]) }
        lainnya { baru = gabung(baru, [t]) }
        i = i + 1
    }
    kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: baru, jumlah_selesai: hitung_selesai(baru), tema_terang: state.tema_terang, modal_buka: state.modal_buka, toast: "Tugas diperbarui", detik: state.detik }
}

fungsi aksi_hapus(props, state, e) {
    ingat idx = ke_angka(dom_atribut(e.target, "data-indeks"))
    ingat baru = []
    ingat i = 0
    ulang (i < panjang(state.tugas)) {
        kalau (i != idx) { baru = gabung(baru, [state.tugas[i]]) }
        i = i + 1
    }
    kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: baru, jumlah_selesai: hitung_selesai(baru), tema_terang: state.tema_terang, modal_buka: state.modal_buka, toast: "Tugas dihapus", detik: state.detik }
}

fungsi aksi_tema(props, state, e) {
    ingat baru = !state.tema_terang
    kalau (baru) { dom_tambah_kelas(dom_pilih("body"), "terang") }
    lainnya { dom_hapus_kelas(dom_pilih("body"), "terang") }
    simpan_lokal("isoteri_demo_tema", teks_bool(baru))
    kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: state.tugas, jumlah_selesai: state.jumlah_selesai, tema_terang: baru, modal_buka: state.modal_buka, toast: "Tema diubah", detik: state.detik }
}

fungsi aksi_modal(props, state, e) {
    kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: state.tugas, jumlah_selesai: state.jumlah_selesai, tema_terang: state.tema_terang, modal_buka: !state.modal_buka, toast: state.toast, detik: state.detik }
}

fungsi aksi_tambah(props, state, e) {
    ingat baru = gabung(state.tugas, [Tugas { teks: "Tugas baru dari Isoteri", selesai: salah, prioritas: "sedang" }])
    kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: baru, jumlah_selesai: hitung_selesai(baru), tema_terang: state.tema_terang, modal_buka: salah, toast: "Tugas baru ditambahkan", detik: state.detik }
}

fungsi aksi_tutup(props, state, e) { kembalikan AppState { halaman: state.halaman, pencarian: state.pencarian, tugas: state.tugas, jumlah_selesai: state.jumlah_selesai, tema_terang: state.tema_terang, modal_buka: salah, toast: state.toast, detik: state.detik } }

fungsi render_dengan_modal(props, state) {
    ingat isi = render(props, state)
    kalau (state.modal_buka) {
        isi = isi + "<div class='modal'><div class='modal-box'><h3>Proyek baru</h3><p>Dialog ini adalah contoh kecil bahwa state UI juga bisa dikelola oleh Isoteri. Belum ada backend—jadi tombolnya sengaja hanya menutup dialog atau menambahkan tugas demo.</p><div class='actions'><button class='btn' data-aksi='tutup'>Batal</button><button class='btn primary' data-aksi='tambah'>Buat contoh</button></div></div></div>"
    }
    kalau (panjang(state.toast) > 0) { isi = isi + "<div class='toast'>" + state.toast + "</div>" }
    kembalikan isi
}

fungsi hook(props, state) {
    tampilkan "Isoteri UI render: " + state.halaman
}

fungsi saat_rute(params) {
    kembalikan params
}

ingat awal = [
    Tugas { teks: "Stabilkan overflow-trapping di JIT", selesai: salah, prioritas: "tinggi" },
    Tugas { teks: "Buat demo web nyata tanpa JS aplikasi", selesai: benar, prioritas: "selesai" },
    Tugas { teks: "Rapikan type system Isoteri", selesai: salah, prioritas: "sedang" },
    Tugas { teks: "Uji semantic equivalence VM/JIT/AOT", selesai: salah, prioritas: "tinggi" }
]

ingat tema = ambil_lokal("isoteri_demo_tema")	
ingat terang = (tema == "ya")
kalau (terang) { dom_tambah_kelas(dom_pilih("body"), "terang") }

fungsi render_route(params) { kembalikan params }

rute_daftar([
    {"pola": "/", "tampilkan": "render_route"},
    {"pola": "/tugas", "tampilkan": "render_route"},
    {"pola": "/proyek", "tampilkan": "render_route"},
    {"pola": "/pengaturan", "tampilkan": "render_route"}
])
rute_mulai()

ingat path_awal = rute_sekarang().path
ingat halaman_awal = "beranda"
kalau (path_awal == "/tugas") { halaman_awal = "tugas" }
kalau (path_awal == "/proyek") { halaman_awal = "proyek" }
kalau (path_awal == "/pengaturan") { halaman_awal = "pengaturan" }

ingat toko = state_buat(AppState { halaman: halaman_awal, pencarian: "", tugas: awal, jumlah_selesai: hitung_selesai(awal), tema_terang: terang, modal_buka: salah, toast: "", detik: 0 })

fungsi render_utama(props, state) {
    kembalikan render_dengan_modal(props, state)
}

ingat aplikasi = komponen_buat({
    "state_awal": state_nilai(toko),
    "render": "render_utama",
    "aksi": {
        "tema": "aksi_tema",
        "navigasi": "aksi_navigasi",
        "modal": "aksi_modal",
        "tambah": "aksi_tambah",
        "tutup": "aksi_tutup",
        "toggle": "aksi_toggle",
        "hapus": "aksi_hapus",
        "cari": "aksi_cari"
    },
    "dipasang": "hook",
    "diperbarui": "hook"
})

komponen_pasang(aplikasi, dom_pilih("#app"))

ingat detik = 0
fungsi tick() {
    detik = detik + 1
}
interval_mulai(1000, "tick")
